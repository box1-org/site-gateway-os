# Box1 site-ops handheld pages (box1-org/site-gateway, module ops), from the bundle copied into this image by
# digest. Runs only on a site instance: /etc/box1/site.env comes from the instance's
# cloud-init disk (box1-docs#140). Listens on 127.0.0.1:8081.
[Unit]
Description=Box1 site-ops handheld pages
Documentation=https://github.com/box1-org/site-gateway
ConditionPathExists=/etc/box1/site.env
Wants=site-gateway.service
After=site-gateway.service

[Service]
Type=simple
User=box1-site
Group=box1-site
EnvironmentFile=/etc/box1/site.env
Environment=HTTP_PORT=8081
ExecStart=/usr/bin/java -Xmx192m -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp -jar /usr/lib/box1/site-gateway/ops/quarkus-app/quarkus-run.jar
WorkingDirectory=/usr/lib/box1/site-gateway/ops
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=0
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=site-gateway-os.target
