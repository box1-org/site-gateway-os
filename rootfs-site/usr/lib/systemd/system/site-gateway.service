# Box1 site gateway: MQTT to Kafka forwarder, pick list, site agent (box1-org/site-gateway, module gateway), from the bundle copied into this image by
# digest. Runs only on a site instance: /etc/box1/site.env comes from the instance's
# cloud-init disk (box1-docs#140). Listens on 127.0.0.1:8080.
[Unit]
Description=Box1 site gateway: MQTT to Kafka forwarder, pick list, site agent
Documentation=https://github.com/box1-org/site-gateway
ConditionPathExists=/etc/box1/site.env
Requires=site-postgres.service site-broker.service
After=site-postgres.service site-broker.service box1-site-facts.service network-online.target
Wants=network-online.target box1-site-facts.timer

[Service]
Type=simple
User=box1-site
Group=box1-site
EnvironmentFile=/etc/box1/site.env
EnvironmentFile=/var/lib/box1-site/secrets/gateway.env
Environment=HTTP_PORT=8080
ExecStart=/usr/bin/java -Xmx384m -XX:+ExitOnOutOfMemoryError -Djava.io.tmpdir=/tmp -jar /usr/lib/box1/site-gateway/gateway/quarkus-app/quarkus-run.jar
WorkingDirectory=/usr/lib/box1/site-gateway/gateway
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=0
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=site-gateway-os.target
