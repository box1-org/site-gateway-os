# Generates the site PostgreSQL password once, on the first boot of an instance, into
# /var/lib/box1-site/secrets (root only). /var persists across bootc upgrades and
# rollbacks, so the password matches the database it initialised. It is never in Git,
# the image or a log.
[Unit]
Description=Box1 site local secrets (generated once)
ConditionPathExists=/etc/box1/site.env
After=local-fs.target
Before=site-postgres.service site-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/box1/site-secrets

[Install]
WantedBy=site-gateway-os.target
