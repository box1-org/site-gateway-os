#!/bin/bash
# box1-docs#126: create the site database credentials once. Root-only files; systemd
# reads them as EnvironmentFile= before starting a service, so the services never need
# to read them. Existing files are never changed (the database was initialised with them).
set -euo pipefail
umask 077
dir=/var/lib/box1-site/secrets
install -d -m 0700 -o root -g root "$dir"
if [ -s "$dir/postgres.env" ] && [ -s "$dir/gateway.env" ]; then
  echo "site secrets present"
  exit 0
fi
if [ -e "$dir/postgres.env" ] || [ -e "$dir/gateway.env" ]; then
  echo "site secrets are incomplete; refusing to generate a new password for an existing database" >&2
  exit 1
fi
password=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
tmp=$(mktemp "$dir/.new.XXXXXX")
printf 'POSTGRESQL_USER=site\nPOSTGRESQL_DATABASE=site\nPOSTGRESQL_PASSWORD=%s\n' "$password" > "$tmp"
mv "$tmp" "$dir/postgres.env"
tmp=$(mktemp "$dir/.new.XXXXXX")
printf 'SITE_DB_PASSWORD=%s\n' "$password" > "$tmp"
mv "$tmp" "$dir/gateway.env"
echo "site secrets generated"
